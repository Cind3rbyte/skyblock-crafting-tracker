 "hints": {
  "MITHRIL_ORE": {
   "how": "Abbauen in den Dwarven Mines (Mithril-Erz, graue und hellblaue Blöcke) mit Drill oder Spitzhacke. Je höher Mining Speed und Mining Fortune, desto schneller. Alle 160 Erz ergeben 1 Enchanted Mithril."
  },
  "IRON_INGOT": {
   "how": "Iron-Minion auf der gemeinsamen Co-op-Insel (liefert Barren) oder in Gold Mines, Deep Caverns und Dwarven Mines abbauen."
  },
  "REDSTONE": {
   "how": "Redstone-Minion auf der Co-op-Insel oder in den Deep Caverns und Dwarven Mines abbauen."
  },
  "GOLD_INGOT": {
   "how": "Gold-Minion auf der Co-op-Insel (liefert Barren) oder in den Gold Mines abbauen."
  },
  "DIAMOND": {
   "how": "Diamond-Minion auf der Co-op-Insel oder in der Diamond Reserve und den Deep Caverns abbauen."
  },
  "COAL": {
   "how": "Coal-Minion auf der Co-op-Insel oder in der Coal Mine abbauen."
  },
  "TREASURITE": {
   "how": "Nur Drops, kein Handel bei Ironman: Treasure Hoarder (0,5 %), einige Bosse (1 %), Truhen in Mithril Deposits, Crystal-Nucleus-Stash und Angeln im See der Upper Mines."
  },
  "GLACITE_JEWEL": {
   "how": "Laut einer Drittquelle droppt es mit 0,5 % von Ice Walkern in den Dwarven Mines. Nicht im Wiki bestätigt, bitte im Spiel gegenprüfen."
  }
 },
